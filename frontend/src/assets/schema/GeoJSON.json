{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/neuroinformatics/jnode-abstracts/main/frontend/src/assets/schema/GeoJSON.json",
  "title": "GeoJSON",
  "$defs": {
    "_coordinates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number"
      }
    },
    "_bbox": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "number"
      }
    },
    "Point": {
      "title": "GeoJSON Point",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Point"]
        },
        "coordinates": {
          "$ref": "#/$defs/_coordinates"
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "LineString": {
      "title": "GeoJSON LineString",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["LineString"]
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/_coordinates"
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "Polygon": {
      "title": "GeoJSON Polygon",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon"]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/_coordinates"
            }
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "MultiPoint": {
      "title": "GeoJSON MultiPoint",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["MultiPoint"]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/_coordinates"
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "MultiLineString": {
      "title": "GeoJSON MultiLineString",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["MultiLineString"]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/_coordinates"
            }
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "MultiPolygon": {
      "title": "GeoJSON MultiPolygon",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["MultiPolygon"]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "$ref": "#/$defs/_coordinates"
              }
            }
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "GeometryCollection": {
      "title": "GeoJSON GeometryCollection",
      "type": "object",
      "required": ["type", "geometries"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["GeometryCollection"]
        },
        "geometries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Point"
              },
              {
                "$ref": "#/$defs/LineString"
              },
              {
                "$ref": "#/$defs/Polygon"
              },
              {
                "$ref": "#/$defs/MultiPoint"
              },
              {
                "$ref": "#/$defs/MultiLineString"
              },
              {
                "$ref": "#/$defs/MultiPolygon"
              }
            ]
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "Feature": {
      "title": "GeoJSON Feature",
      "type": "object",
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Feature"]
        },
        "id": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "properties": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPoint"
            },
            {
              "$ref": "#/$defs/MultiLineString"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            },
            {
              "$ref": "#/$defs/GeometryCollection"
            }
          ]
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    },
    "FeatureCollection": {
      "title": "GeoJSON FeatureCollection",
      "type": "object",
      "required": ["type", "features"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["FeatureCollection"]
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Feature"
          }
        },
        "bbox": {
          "$ref": "#/$defs/_bbox"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Point"
    },
    {
      "$ref": "#/$defs/LineString"
    },
    {
      "$ref": "#/$defs/Polygon"
    },
    {
      "$ref": "#/$defs/MultiPoint"
    },
    {
      "$ref": "#/$defs/MultiLineString"
    },
    {
      "$ref": "#/$defs/MultiPolygon"
    },
    {
      "$ref": "#/$defs/GeometryCollection"
    },
    {
      "$ref": "#/$defs/Feature"
    },
    {
      "$ref": "#/$defs/FeatureCollection"
    }
  ]
}
